## HitStop —— 命中顿帧服务（Autoload 单例）
##
## 【负责什么】
##   命中瞬间把 Engine.time_scale 压到接近 0，持续极短时间，制造"刀刀到肉"的
##   顿挫感。这是动作游戏打击感最重要的单一因素。
##
## 【挂哪个节点】
##   project.godot 的 [autoload] 注册为 `HitStop`。
##
## 【依赖谁】
##   EventBus.hit_stop_requested。
##
## 【怎么扩展】
##   想要"不同目标不同顿帧"由调用方传不同 duration 即可，这里只负责计时。
##   若将来需要全局慢动作（子弹时间），在此加一个独立的 slow_motion 通道，
##   不要复用顿帧通道，否则两者会互相覆盖。
##
## 【关键实现点】
##   计时必须用 `ignore_time_scale = true` 的定时器，否则 time_scale 一压低，
##   计时器自己也被拖慢，顿帧会永远结束不了。
extends Node

# ============================================================================
# @export
# ============================================================================

## 顿帧期间的时间缩放。0.0 是完全冻结；0.05 会保留极轻微的运动，观感更"活"。
@export_range(0.0, 1.0, 0.01) var time_scale: float = 0.0
## 单次顿帧时长上限（秒），防止误传大数值把游戏卡死。
@export_range(0.01, 1.0, 0.01, "suffix:s") var max_duration: float = 0.3

# ============================================================================
# 私有变量
# ============================================================================

## 请求代次。每次新请求 +1，旧请求醒来后发现代次变了就放弃恢复 time_scale，
## 从而正确处理"顿帧期间又打中一下"的重叠情况。
var _token: int = 0

# ============================================================================
# 生命周期
# ============================================================================

func _ready() -> void:
	# 顿帧不应该在切场景时残留，退出树时强制复位。
	tree_exiting.connect(_on_tree_exiting)
	EventBus.hit_stop_requested.connect(request)


# ============================================================================
# 公开方法
# ============================================================================

## 请求一次顿帧。duration <= 0 时忽略（允许攻击数据里填 0 表示不顿帧）。
func request(duration: float) -> void:
	if duration <= 0.0:
		return
	var clamped: float = minf(duration, max_duration)
	_token += 1
	var my_token: int = _token
	Engine.time_scale = time_scale
	# 第 4 个参数 ignore_time_scale = true 是这里的关键：计时器不受 time_scale 影响。
	await get_tree().create_timer(clamped, true, false, true).timeout
	# 只有"最后一次请求"才有权恢复时间，避免嵌套顿帧提前解冻。
	if my_token == _token:
		Engine.time_scale = 1.0


# ============================================================================
# 信号回调
# ============================================================================

func _on_tree_exiting() -> void:
	Engine.time_scale = 1.0
