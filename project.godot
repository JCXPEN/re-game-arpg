; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ActRPG"
config/description="2D 俯视动作 ARPG 原型：城镇 → 野外 → 地牢 → Boss 房"
run/main_scene="res://scenes/core/boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
UIRegistry="*res://scripts/core/ui_registry.gd"
PopupManager="*res://scripts/ui/popup_manager.gd"
UIInputRouter="*res://scripts/ui/ui_input_router.gd"
PauseManager="*res://scripts/ui/pause_manager.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
SaveManager="*res://scripts/core/save_manager.gd"
GameState="*res://scripts/core/game_state.gd"
ModifierSystem="*res://scripts/roguelite/modifier_system.gd"
TutorialSystem="*res://scripts/core/tutorial_system.gd"
HitStop="*res://scripts/core/hit_stop.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
SettingsService="*res://scripts/core/settings_service.gd"
SceneDirector="*res://scripts/core/scene_director.gd"
GameFlow="*res://scripts/core/game_flow.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

